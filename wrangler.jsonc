{
  // Cloudflare Workers config for Domio (built with @opennextjs/cloudflare).
  // Docs: https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domio",
  // Mayank.kashyap@invotechservices.com's Cloudflare account
  "account_id": "0b1706b94be271ff1b5f561468b5f812",
  // Custom entry: OpenNext's fetch handler + the daily reminder cron (see worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "domio" }
  ],
  // 03:30 UTC = 09:00 IST, daily rent reminders (same as vercel.json).
  "triggers": {
    "crons": ["30 3 * * *"]
  },
  // On Workers Paid, add: "limits": { "cpu_ms": 60000 } (not allowed on the free plan).
  "observability": { "enabled": true },
  // Keep variables set in the Cloudflare dashboard when deploying from git.
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true
}
